// Pensum app data model — see /home/felipe/.claude/plans/since-we-can-indeed-structured-gadget.md §B
// Postgres: Neon (Vercel preview) in the cloud, a local docker-compose `db` service for dev.
//   DATABASE_URL — pooled connection (PgBouncer on Neon); used by the app at runtime.
//   DIRECT_URL   — direct connection; used by `prisma migrate` / introspection only.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for the Vercel/AWS Lambda runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

/// A recommended-pensum variant (one Excel sheet). Students pick one of these.
model Catalog {
  id             Int      @id @default(autoincrement())
  slug           String   @unique // iele-cbu3 | iele-cbu3-pc | ielc-cbu3 | ielc-cbu3-pc | doble-cbu3
  programCode    String // IELE | IELC | DOBLE
  programName    String // "Ingeniería Eléctrica"
  variantLabel   String // "" | "con Precálculo" | "Electrónica" | "Doble programa"
  status         String   @default("draft") // draft | published | archived
  term           String // term offerings were synced against, e.g. "202620"
  sourceFilename String?
  // --- presentation identity (shown on the picker card + the explorer header) ---
  accentColor    String? // "#0e8a95"
  tagline        String? // one-liner shown on the picker card
  subtitle       String? // e.g. "CBU3 · 8 semestres"
  imagePath      String? // "/assets/pensums/iele-cbu3.svg"
  // --- admin progression rules: { gates: GateRule[], attestations: Attestation[] } ---
  rules          Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  courses          CatalogCourse[]
  requirementNodes RequirementNode[]
  snapshots        CatalogSnapshot[]
  importJobs       ImportJob[]

  @@index([status])
}

/// A non-course graduation requirement drawn as a 0-credit node in the map
/// (today: "Requisito de lectura en inglés"). Fully editable from /administrador;
/// `lib/requirementNodes.ts` only provides the first-load bootstrap.
model RequirementNode {
  id                Int      @id @default(autoincrement())
  catalogId         Int
  key               String // stable slug, e.g. "req-lectura-ingles"
  label             String
  description       String?
  infoUrl           String?
  credits           Float    @default(0)
  semester          Int // which column it sits under
  sortIndex         Int      @default(9999) // position within the column (bottom by default)
  /// ties its "cumplido" state to a Catalog.rules attestation id (e.g. "idioma")
  attestationId     String?
  /// explicit normalizedCodes of courses that require it (admin-managed); null = []
  linkedCourseCodes Json?
  /// on import, auto-attach to any course whose prereq references a matching code
  autoLinkRegex     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@unique([catalogId, key])
  @@index([catalogId])
}

/// Global course registry — MATE1105 is the same course across programs.
model Course {
  id             Int      @id @default(autoincrement())
  normalizedCode String   @unique // "IELE2100"
  nameEs         String
  nameEn         String?
  defaultCredits Float?
  createdAt      DateTime @default(now())
  // --- catalog description, from the smartcatalogiq scraper (scripts/scrapeDescriptions.ts).
  //     Admin-editable; the seed never touches these. ---
  description        String?
  descriptionUrl    String?
  descriptionSyncedAt DateTime?

  catalogCourses CatalogCourse[]
  offerings      CourseOffering[]
}

/// A course's (or placeholder slot's) role inside one catalog.
model CatalogCourse {
  id                Int     @id @default(autoincrement())
  catalogId         Int
  courseId          Int? // null for an unbound placeholder
  displayCode       String // raw Excel col1: "IELE 2100" | "CBU" | "ELECTIVA IELE" | "IELE 301X"
  name              String
  credits           Float
  suggestedSemester Int
  courseType        String // nucleo|electiva|cbu|complementaria|proyecto
  isPlaceholder     Boolean @default(false)
  placeholderKind   String? // CBU|ELECTIVA|EFI|CLE|DEPT|CODEX|CI
  placeholderLabel  String?
  sortIndex         Int // sheet row order within catalog (stable slot key)
  prereqText        String?
  coreqText         String?
  prereqTree        Json? // ReqNode | null — consumed as-is by lib/availability.ts
  coreqTree         Json?
  pairingStatus     String  @default("needs_manual")
  // auto_paired | not_offered | needs_manual | manual_resolved | placeholder_pool | sync_failed
  /// set once an admin edits this row by hand — a re-import must not silently
  /// clobber it (surfaces in the diff instead)
  manuallyEdited    Boolean @default(false)
  /// field names the admin pinned against import overwrites (null = none)
  lockedFields      Json?

  catalog       Catalog        @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  course        Course?        @relation(fields: [courseId], references: [id])
  manualPairing ManualPairing?

  @@unique([catalogId, sortIndex])
  @@index([catalogId])
  @@index([pairingStatus])
}

/// Live offering data from ofertadecursos.uniandes.edu.co, per (course, term).
/// One fetch serves every catalog that contains the course.
model CourseOffering {
  id                Int      @id @default(autoincrement())
  courseId          Int
  term              String
  offered           Boolean
  canonicalTitle    String?
  canonicalCredits  Float?
  sectionCount      Int      @default(0)
  seatsAvailableMin Int?
  seatsAvailableMax Int?
  attrs             Json? // string[] e.g. ["EPSI","VIRT"]
  ptrmSet           Json? // string[] e.g. ["8A","16"]
  lastSyncedAt      DateTime @default(now())
  syncError         String?

  // --- live prereq/coreq/restrictions from /api/courseDetails (source of truth
  //     when present; the PRERREQUISITOS .xlsx is the fallback for courses with
  //     no offering this term) ---
  detailsNrc      String? // NRC the details were read from
  apiPrereqText   String? // raw Spanish boolean expression
  apiPrereqTree   Json? // ReqNode | null  (parsed apiPrereqText)
  apiCoreq        Json? // [{subject,coursenumber,title,normalizedCode}]
  apiCoreqTree    Json? // ReqNode | null  (AND of apiCoreq normalizedCodes)
  restrictions    Json? // [{type,ind,desc[]}] — informational only, never blocks
  detailsCompl    Json? // raw `compl` array (unused for now)
  detailsMaster   Json? // raw `master` array (unused for now)
  detailsError    String? // set when the courseDetails fetch failed
  detailsSyncedAt DateTime?

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, term])
  @@index([term])
}

/// One row per catalog_course that could not be auto-paired. Prefilled from the Excel.
model ManualPairing {
  id                Int       @id @default(autoincrement())
  catalogCourseId   Int       @unique
  excelCode         String
  excelName         String
  excelCredits      Float?
  excelSemester     Int?
  excelPrereqText   String?
  suggestedCode     String?
  candidateCodes    Json? // string[] (placeholder pools)
  resolvedCode      String?
  resolvedNote      String?
  keepAsPlaceholder Boolean   @default(false)
  resolvedBy        String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())

  catalogCourse CatalogCourse @relation(fields: [catalogCourseId], references: [id], onDelete: Cascade)
}

/// An uploaded Excel awaiting review. Nothing is applied until an admin confirms.
model ImportJob {
  id             Int       @id @default(autoincrement())
  filename       String
  prereqFilename String?
  uploadedBy     String
  status         String    @default("parsed") // parsed | failed | applied | discarded
  scope          String // "all" | a catalog slug
  diff           Json?
  errors         Json?
  warnings       Json?
  parsedPayload  Json? // ParsedCatalog[] retained until apply/discard
  uploadedAt     DateTime  @default(now())
  appliedAt      DateTime?
  catalogId      Int?

  catalog Catalog? @relation(fields: [catalogId], references: [id])
}

/// Full denormalized catalog snapshot for rollback (written before every import/restore).
model CatalogSnapshot {
  id        Int      @id @default(autoincrement())
  catalogId Int
  payload   Json
  reason    String // pre-import | pre-restore | manual
  createdBy String?
  createdAt DateTime @default(now())

  catalog Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId])
}

/// One row per elective course in the "BOLSA DE ELECTIVAS" spreadsheets. These
/// sheets carry no course codes — only long names + per-program validity for two
/// pensum eras. Indexed separately for Ing. Eléctrica (IELE) vs Electrónica (IELC).
model Elective {
  id             Int      @id @default(autoincrement())
  name           String // long course name, as printed
  normalizedName String   @unique // accent-folded, upper, space-collapsed
  code           String? // paired course code if ever resolved (left null for now)
  level          String // "pregrado" | "maestria" | "other"
  ciclo          String? // from "MATERIAS MAESTRIA" sheet
  roles          Json // { eleFrom2024:{norm,raw}, elcFrom2024, eleUntil2023, elcUntil2023 }
  isCursoIntegrador Boolean @default(false) // "ES CURSO INTEGRADOR" flag in the bag
  offeredTerms   Json // string[]  e.g. ["202620"]
  sourceFiles    Json // string[]  provenance
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  actor      String
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}
