# Copy to .env for local dev. On Vercel these are set as Project → Settings → Environment Variables.

# --- Database (Postgres) ---
# Local dev: the docker-compose `db` service (repo root: `docker compose up -d db`).
# Prod: Neon. Use the POOLED connstring here (host has "-pooler"), and the DIRECT
# one below. Both need `?sslmode=require` on Neon.
DATABASE_URL="postgresql://pensum:pensum@localhost:5432/pensum?schema=public"
# Direct (non-pooled) connection — used only by `prisma migrate` / introspection.
# Locally it can be identical to DATABASE_URL. On Neon it's the non-pooler host.
DIRECT_URL="postgresql://pensum:pensum@localhost:5432/pensum?schema=public"

SESSION_SECRET="generate-a-random-32-byte-hex-string"
ADMIN_PASSWORD="set-a-strong-shared-admin-password"
OFFERINGS_TERM="202620"
MIHORARIO_URL="https://open-source-uniandes.github.io/Mi-Horario-Uniandes/"
PUBLIC_BASE_URL="https://pensum.example.edu.co"
PAIRING_CONCURRENCY="4"
UNIANDES_API_URL="https://ofertadecursos.uniandes.edu.co/api/courses"
# Where seed.ts reads the two source .xlsx files from. ".." for local dev (repo root).
SEED_DIR=".."
LOG_LEVEL="info"
